# MediNest Backend Environment Template
# Duplicate this file as .env and fill in your actual credentials

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# JWT Authentication
# Must be a cryptographically secure random string (minimum 32 characters)
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-a-secure-random-32-char-minimum-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Server Environment
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
DEBUG=True
